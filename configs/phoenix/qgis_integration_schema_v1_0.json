{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phoenix QGIS Integration Project",
  "type": "object",
  "required": [
    "name",
    "project_id",
    "crs",
    "layers"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "crs": {
      "type": "string",
      "minLength": 1
    },
    "layers": {
      "type": "array"
    },
    "extent": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
