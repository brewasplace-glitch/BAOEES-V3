{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PHOENIX_EXECUTION_PLAN_V1_SCHEMA",
  "type": "object",
  "required": [
    "schema",
    "plan_id",
    "goal_id",
    "status",
    "policy_bundle_sha256",
    "steps",
    "topological_order",
    "execution_batches",
    "plan_sha256"
  ],
  "properties": {
    "schema": {
      "const": "PHOENIX_EXECUTION_PLAN_V1"
    },
    "status": {
      "enum": [
        "READY",
        "GATED",
        "HUMAN_DECISION_REQUIRED",
        "BLOCKED"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1
    },
    "topological_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_batches": {
      "type": "array"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
