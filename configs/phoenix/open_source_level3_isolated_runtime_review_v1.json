  "primary": {
    "id": "containers.podman.machine.rootless",
    "name": "Podman Machine",
    "license": "Apache-2.0",
    "upstream": "https://github.com/containers/podman",
    "windows_documentation": "https://podman-desktop.io/docs/installation/windows-install",
    "decision": "CONDITIONAL_ADMISSION",
    "requirements": [
      "Windows Podman machine is already installed and running",
      "active connection is rootless",
      "container image is already local and bound by sha256 digest",
      "pull policy is never",
      "network is none",
      "root filesystem is read-only",
      "all capabilities are dropped",
      "no-new-privileges is enabled",
      "no host or repository mounts"
    ]
