{
  "schema": "PHOENIX_GOVERNED_CONTINUOUS_LEVEL5_POLICY_V1",
  "version": "1.0.0",
  "mode": "SCHEDULED_GOVERNED_HEALTH_WINDOWS",
  "monitoring_enabled": true,
  "persistent_daemon": false,
  "persistent_os_task_install": true,
  "automatic_repository_mutation": false,
  "automatic_promotion": false,
  "automatic_engine_activation": false,
  "dependency_install": "DENY",
  "network_access": "GIT_REMOTE_SYNC_ONLY",
  "force_push": "DENY",
  "history_rewrite": "DENY",
  "human_kill_switch": "REQUIRED",
  "kill_switch_filename": "PHOENIX_LEVEL5_STOP",
  "lock_filename": "PHOENIX_LEVEL5_WINDOW.lock",
  "max_windows_per_invocation": 1,
  "max_tasks_selected_per_window": 1,
  "minimum_window_interval_seconds": 3600,
  "missed_window_fail_closed_seconds": 172800,
  "scheduler": {
    "task_name": "PROJECT-PHOENIX Governed Level5 Health Window",
    "frequency": "DAILY",
    "local_time": "01:00",
    "timezone": "Europe/Amsterdam",
    "overlap": "DENY",
    "start_when_available_after_missed_run": false,
    "run_on_battery": true,
    "wake_to_run": false
  },
  "required_health_signals": [
    "repository_clean",
    "repository_remote_synchronized",
    "accepted_isolation_provider",
    "policy_bundle_present",
    "dependency_manifest_digest",
    "low_risk_backlog_observation"
  ],
  "state_backend": "ATOMIC_JSON_HMAC_BOUND",
  "health_record_filename": "level5_health_latest_v1.json",
  "audit_filename": "level5_health_audit_v1.jsonl",
  "scheduled_action": "OBSERVE_VALIDATE_AND_PROPOSE_ONLY",
  "promotion_requires_separate_governed_cycle": true
}
