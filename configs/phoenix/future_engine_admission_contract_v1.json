{
  "schema": "PHOENIX_FUTURE_ENGINE_ADMISSION_CONTRACT_V1",
  "version": "1.4.0",
  "scope": "ALL_FUTURE_ENGINES",
  "default_if_not_registered": "DENY",
  "requirements_for_mutation_capable_engine": [
    "unique_engine_id",
    "engine_registry_entry",
    "gateway_required_true",
    "declared_allowed_actions",
    "declared_allowed_domains",
    "declared_mutation_scope",
    "central_policy_decision",
    "one_time_gateway_permit",
    "permit_consumed_immediately_before_mutation",
    "policy_decision_log",
    "gateway_audit_log",
    "tests_for_ungated_denial",
    "executor_adapter_registry_entry_for_each_active_action",
    "plan_dispatchable_actions_have_executable_adapter",
    "adapter_engine_action_binding_exact",
    "candidate_manifest_passes_schema_and_semantic_validation",
    "capability_discovery_non_executing",
    "adapter_generation_staging_only",
    "admission_report_pass",
    "phase6_signed_proposal_verified",
    "implementation_contract_pass",
    "engine_activation_transaction_ready",
    "governed_activation_approval_present",
    "deterministic_adapter_synthesis_spec_digest",
    "signed_adapter_verification_attestation",
    "accepted_security_boundary_before_candidate_execution"
  ],
  "prohibited_patterns": [
    "silent_policy_bypass",
    "unregistered_mutation",
    "permit_reuse",
    "permit_sharing_between_engines",
    "permit_action_or_path_rebinding",
    "unregistered_executor_adapter",
    "adapter_action_scope_expansion",
    "adapter_gateway_bypass",
    "dynamic_import_during_untrusted_discovery",
    "automatic_activation_from_discovery",
    "generated_adapter_direct_repository_write_without_governed_install",
    "activation_without_verified_backup",
    "activation_without_explicit_approval",
    "policy_deny_auto_weakening",
    "untrusted_candidate_execution_during_validation",
    "mutation_capable_adapter_automatic_synthesis",
    "candidate_execution_without_accepted_security_boundary",
    "phase8_handoff_direct_repository_write",
    "phase8_handoff_automatic_activation"
  ],
  "executor_adapter_contract": {
    "all_active_engine_actions_require_registry_coverage": true,
    "plan_dispatchable_action_requires_executable_adapter": true,
    "future_action_default": "DENY_NO_REGISTERED_ADAPTER",
    "mutating_adapter_gateway_required": true,
    "adapter_engine_action_binding_exact": true,
    "adapter_cannot_expand_engine_action_scope": true
  },
  "autonomous_onboarding_contract": {
    "candidate_manifest_required": true,
    "discovery_must_not_import_candidate_code": true,
    "capability_declarations_explicit": true,
    "adapter_generation_staging_only": true,
    "admission_tests_required": true,
    "repository_activation_requires_governed_change": true,
    "mutating_engine_automatic_activation": false
  },
  "governed_activation_contract": {
    "phase6_signed_proposal_required": true,
    "implementation_static_validation_required": true,
    "candidate_code_execution_during_validation": false,
    "explicit_activation_approval_required": true,
    "verified_backup_required": true,
    "policy_deny_cannot_be_auto_weakened": true,
    "normal_non_force_push_only": true
  },
  "adapter_synthesis_contract": {
    "phase6_signed_proposal_required": true,
    "read_only_deterministic_synthesis_only": true,
    "exact_source_replay_required": true,
    "candidate_execution_requires_accepted_security_boundary": true,
    "candidate_execution_enabled_in_v1": false,
    "signed_attestation_required": true,
    "governed_handoff_requires_explicit_sha_binding": true,
    "handoff_repository_write": false,
    "automatic_activation": false
  }
}
