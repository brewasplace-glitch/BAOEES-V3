{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PHOENIX_GENERATED_ADAPTER_IMPLEMENTATION_CONTRACT_V1_SCHEMA",
  "type": "object",
  "required": [
    "adapter_id",
    "engine_id",
    "actions",
    "mutation_capable",
    "gateway_required",
