{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phoenix.autonomous-build-manifest-schema/1.0",
  "title": "Project Phoenix Autonomous Build Manifest v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "build_id",
    "title",
    "branch",
    "baseline",
    "classification"
  ],
  "properties": {
    "schema_version": {
      "const": "phoenix.autonomous-build-manifest/1.0"
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "classification": {
      "enum": [
        "REUSE",
        "REPAIR",
        "EXTEND",
        "BUILD"
      ]
    },
    "commit_message": {
      "type": "string"
    },
    "expected_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "existing_markers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "health_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "impact_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "smoke_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "auto_commit": {
      "type": "boolean",
      "default": true
    },
    "auto_push": {
      "type": "boolean",
      "default": true
    },
    "rollback_on_failure": {
      "type": "boolean",
      "default": true
    },
    "allow_reuse_noop": {
      "type": "boolean",
      "default": true
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "cwd": {
          "type": "string",
          "default": "."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "command"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "build",
            "repair",
            "test",
            "smoke",
            "verify"
          ]
        },
        "description": {
          "type": "string"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "repair_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    }
  }
}
