{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-phoenix.local/schema/release-evidence-submission-1.0.json",
  "title": "PHOENIX Release Evidence Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "hold_id",
    "issuer",
    "evidence_date",
    "evidence_files",
    "assertions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "const": "PHX-RP-ANIJSTRAAT-616"
    },
    "hold_id": {
      "enum": [
        "H01",
        "H02",
        "H03",
        "H04",
        "H05",
        "H06",
        "H07",
        "H08"
      ]
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "organization",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "registration_or_authority_id": {
          "type": "string"
        },
        "contact_reference": {
          "type": "string"
        }
      }
    },
    "evidence_date": {
      "type": "string",
      "format": "date"
    },
    "evidence_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "document_type"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "document_type": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_basis": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "professional_approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "NOT_APPLICABLE",
            "REVIEW_ONLY",
            "APPROVED_FOR_CONSTRUCTION"
          ]
        },
        "scope": {
          "type": "string"
        },
        "credential_confirmation": {
          "type": "boolean"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "signed_file",
        "signature_file",
        "public_key_pem_file"
      ],
      "properties": {
        "algorithm": {
          "const": "ED25519"
        },
        "signed_file": {
          "type": "string",
          "minLength": 1
        },
        "signature_file": {
          "type": "string",
          "minLength": 1
        },
        "public_key_pem_file": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}