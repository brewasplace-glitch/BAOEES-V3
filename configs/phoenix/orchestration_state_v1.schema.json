{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PHOENIX_ORCHESTRATION_STATE_V1_SCHEMA",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "plan_id",
    "plan_sha256",
    "policy_bundle_sha256",
    "status",
    "step_states",
    "sequence",
    "checkpoint_hmac_sha256"
  ],
  "properties": {
    "schema": {
      "const": "PHOENIX_ORCHESTRATION_STATE_V1"
    },
    "status": {
      "enum": [
        "RUNNING",
        "PAUSED_APPROVAL",
        "PAUSED_GATES",
        "WAITING_APPROVED_MUTATION",
        "WAITING_EXECUTOR",
        "BLOCKED",
        "REJECTED",
        "RECOVERY_REQUIRED",
        "COMPLETE"
      ]
    },
    "checkpoint_hmac_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
