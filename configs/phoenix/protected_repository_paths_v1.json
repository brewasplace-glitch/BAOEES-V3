{
  "schema": "PHOENIX_PROTECTED_REPOSITORY_PATHS_V1",
  "version": "1.0.0",
  "status": "ACTIVE",
  "case_insensitive": true,
  "deny_symlinks_and_junctions": true,
  "protected_roots": [
    ".git/",
    ".github/",
    "bib/",
    "configs/",
    "runners/",
    "scripts/",
    "tools/"
  ],
  "protected_exact_paths": [
    ".env",
    ".gitattributes",
    ".gitignore",
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "poetry.lock",
    "pipfile",
    "pipfile.lock",
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "phoenix/autonomy/__init__.py",
    "phoenix/autonomy/universal_gateway.py",
    "phoenix/autonomy/decision_engine.py",
    "phoenix/autonomy/approval_resume.py",
    "phoenix/autonomy/engine_activation.py",
    "phoenix/autonomy/promoter.py",
    "phoenix/autonomy/repository_cycle.py",
    "phoenix/autonomy/worktree_guard.py",
    "phoenix/autonomy/change_classifier.py"
  ],
  "protected_suffixes": [
    ".key",
    ".pem",
    ".pfx",
    ".p12",
    ".crt",
    ".cer",
    ".secrets"
  ],
  "windows_reserved_names": [
    "CON",
    "PRN",
    "AUX",
    "NUL",
    "COM1",
    "COM2",
    "COM3",
    "COM4",
    "COM5",
    "COM6",
    "COM7",
    "COM8",
    "COM9",
    "LPT1",
    "LPT2",
    "LPT3",
    "LPT4",
    "LPT5",
    "LPT6",
    "LPT7",
    "LPT8",
    "LPT9"
  ]
}
