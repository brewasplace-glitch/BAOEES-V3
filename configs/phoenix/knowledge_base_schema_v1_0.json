{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phoenix Knowledge Base Document Metadata",
  "type": "object",
  "required": [
    "document_id",
    "title",
    "version",
    "status",
    "domain"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "accepted",
        "superseded"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": true
}
