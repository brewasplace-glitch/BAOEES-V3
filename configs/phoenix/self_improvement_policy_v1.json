  "mainline_promotion": "ENABLED_FF_ONLY_BACKUP_GATED",
  "source_self_modification": "BLOCKED",
  "medium_high_critical": "BLOCKED",
  "orchestration": {
    "v1_runtime": "phoenix_deterministic_bounded_coordinator",
    "open_source_primary_candidate": "Prefect",
    "open_source_fallback_candidate": "LangGraph",
    "external_runtime_dependency_required": false
  },
  "central_decision_engine_required": true,
  "universal_gateway_required": true
}
