{
  "schema": "PHOENIX_AUTONOMY_POLICY_V1",
  "version": "1.0.0",
  "default_mode": "dry-run",
  "low_risk_auto_enabled": true,
  "require_clean_worktree": true,
  "require_remote_sync": true,
  "max_repair_attempts": 3,
  "protected_paths": [
    ".git/",
    "bib/",
    "phoenix/local_app/static/official_start_v3_0/phoenix_detv_cad_bridge.js",
    "runners/"
  ],
  "critical_terms": [
    "production release",
    "for construction",
    "professional approval",
    "secret",
    "credential",
    "token",
    "password",
    "delete repository",
    "force push"
  ],
  "v1_execution_policy": {
    "dry_run": "ENABLED",
    "low_risk_auto": "ENABLED_CANDIDATE_AND_BACKUP_GATED_PROMOTION",
    "medium": "BLOCKED",
    "high": "BLOCKED",
    "critical": "BLOCKED"
  },
  "low_risk_promotion_to_main": "ENABLED_FF_ONLY_BACKUP_GATED",
  "main_branch_autonomous_mutation": "ENABLED_LOW_RISK_PROMOTION_ONLY",
  "mainline_promotion_requires_full_backup": true,
  "mainline_promotion_requires_remote_race_guard": true,
  "mainline_promotion_requires_fast_forward_only": true,
  "low_risk_self_improvement_loop": "ENABLED_BOUNDED_BACKUP_GATED",
  "self_improvement_source_code": "BLOCKED",
  "self_improvement_max_cycles_per_invocation": 1,
  "self_improvement_requires_open_source_review": true
}
