{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phoenix Knowledge Graph",
  "type": "object",
  "required": [
    "schema_version",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "nodes": {
      "type": "array"
    },
    "edges": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
