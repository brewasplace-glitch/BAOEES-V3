{
  "schema": "PHOENIX_UNIVERSAL_AUTONOMY_GATEWAY_POLICY_V1",
  "version": "1.0.0",
  "enabled": true,
  "fail_closed": true,
  "applies_to": "ALL_CURRENT_AND_FUTURE_MUTATION_CAPABLE_ENGINES",
  "future_engine_default": "DENY_UNREGISTERED",
