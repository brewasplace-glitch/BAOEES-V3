    "registry_required": true,
    "gateway_required_for_mutation_capable_engine": true,
    "allowed_actions_required": true,
    "allowed_domains_required": true,
    "new_engine_registration_effect": "ESCALATE",
    "unregistered_mutation_effect": "DENY"
  }
}
