{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phoenix AI Workflow Definition",
  "type": "object",
  "required": [
    "name",
    "version",
    "steps"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "capability"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retry_limit": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
