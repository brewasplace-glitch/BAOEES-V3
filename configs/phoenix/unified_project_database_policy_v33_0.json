{
  "policy_id": "PHOENIX-UPD-33.0",
  "name": "Unified Project Database Policy",
  "persistence": {
    "format": "json",
    "encoding": "utf-8",
    "canonical_sort_keys": true,
    "checksum": "sha256"
  },
  "integrity": {
    "require_existing_objects_for_relationships": true,
    "prevent_delete_with_active_relationships": true,
    "audit_all_mutations": true
  },
  "snapshots": {
    "enabled": true,
    "verify_checksum_before_restore": true
  }
}
