      "effective_date": "2026-08-01",
      "valid_until": "2026-10-31",
      "source_name": "Vervang door echte lokale bron",
      "confidence": "LOW",
      "taxes_included": false
    },
    "prices": [
      {
        "item_code": "EXAMPLE-001",
        "description": "VOORBEELDREGEL - NIET GEBRUIKEN ALS MARKTPRIJS",
        "unit": "m3",
        "unit_price": 0.0,
        "components": {
