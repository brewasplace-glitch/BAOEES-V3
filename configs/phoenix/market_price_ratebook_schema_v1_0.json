{
  "schema_version": "phoenix.market-price-ratebook-schema/1.0",
  "required_metadata": [
    "ratebook_id",
    "title",
    "country_code",
    "currency",
    "effective_date",
    "source_name"
  ],
  "optional_metadata": [
    "region_name",
    "city",
    "valid_until",
    "source_url",
    "confidence",
    "taxes_included",
    "transport_included"
  ],
  "required_price_fields": [
    "item_code",
    "description",
    "unit",
    "unit_price"
  ],
  "price_components": [
    "material",
    "labour",
    "equipment",
    "transport",
    "subcontractor",
    "other"
  ],
  "example": {
