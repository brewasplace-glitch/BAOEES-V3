{
  "schema_version": "1.0",
  "builder_id": "phoenix.release_builder",
  "builder_version": "1.0.0",
  "requirements": {
    "explicit_manifest": true,
    "deterministic_zip_timestamp": "2026-01-01T00:00:00",
    "sha256_required": true,
    "unsafe_paths_rejected": true,
    "missing_files_fail_build": true
  },
  "git_policy": {
    "install_only_on_clean_tree": true,
    "known_interrupted_wave15_1_recovery_supported": true,
    "stop_on_first_error": true,
    "automatic_commit_and_push_after_all_checks": true
  }
}
