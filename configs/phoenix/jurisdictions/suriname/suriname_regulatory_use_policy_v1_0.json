    "foreign_or_eurocode_methodology": "PROJECT_ENGINEERING_METHOD_CANDIDATE_UNLESS_TRACEABLY_ACCEPTED",
    "automatic_override_between_local_rule_and_foreign_standard": false,
    "conflict_action": "BLOCK_OR_REQUIRE_ENGINEERING_REVIEW",
