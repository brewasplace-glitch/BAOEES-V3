  "r9_4_r9_5": {
    "use_primary_surinaame_sources_as_applicability_evidence": true,
    "use_primary_surinaame_sources_as_v8_6_limit_only_when_exact_check_and_limit_are_explicit": true,
    "use_background_file_for_v8_6_limit": false,
    "seismic_applicability": "NOT_RESOLVED_BY_CURRENT_UPLOAD_SET",
    "legal_applicability_of_eurocode_2": "NOT_RESOLVED_BY_CURRENT_UPLOAD_SET"
  },
  "release": {
    "automatic_code_compliance_claim": false,
    "automatic_structural_approval": false,
    "professional_review_required": true,
    "production_release": "LOCKED"
  }
