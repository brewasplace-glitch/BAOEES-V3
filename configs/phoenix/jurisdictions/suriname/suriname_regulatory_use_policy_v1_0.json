{
  "schema_version": "phoenix.suriname.regulatory-use-policy/1.0",
  "policy_id": "PHX-SURINAME-REGULATORY-USE-v1.0",
  "jurisdiction": "Suriname",
  "principles": {
    "preserve_original_sources": true,
    "primary_sources_precede_background_information": true,
    "background_ai_numeric_auto_use": false,
