{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PHOENIX_APPROVAL_RECEIPT_V1_SCHEMA",
  "type": "object",
  "required": [
    "schema",
    "receipt_id",
    "plan_id",
    "plan_sha256",
    "step_id",
    "policy_bundle_sha256",
    "decision",
    "request_nonce",
    "timestamp",
    "hmac_sha256"
  ],
  "properties": {
    "schema": {
      "const": "PHOENIX_APPROVAL_RECEIPT_V1"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT",
        "DEFER"
      ]
    },
    "hmac_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
