{
  "schema": "PHOENIX_AUTONOMY_POLICY_V2",
  "version": "2.8.0",
  "effective_date": "2026-09-15",
  "north_star": {
    "id": "PHOENIX-NORTH-STAR",
    "version": "1.0.0"
  },
  "effects": [
    "ALLOW",
    "ALLOW_WITH_GATES",
    "ESCALATE",
    "DENY"
  ],
  "fail_closed": true,
  "defaults": {
    "mutating": "DENY",
    "read_only": "ESCALATE"
  },
  "risk_posture": {
    "LOW": "rule_controlled",
    "MEDIUM": "ESCALATE",
    "HIGH": "DENY",
    "CRITICAL": "DENY"
  },
  "central_gateway": {
    "required_for_all_mutations": true,
    "decision_log_required": true,
    "bundle_integrity_required": true,
    "deny_if_policy_unavailable": true,
    "required_for_all_current_and_future_mutations": true,
    "engine_registry_required": true,
    "future_engine_default": "DENY_UNREGISTERED",
    "permit_required": true,
    "permit_one_time_use": true,
    "permit_exact_binding_required": true,
    "permit_policy_bundle_binding_required": true,
    "direct_mutation_bypass_effect": "DENY"
  },
  "hard_deny_flags": [
    "fabricate_evidence",
    "force_push",
    "history_rewrite",
    "bypass_gates",
    "disable_audit",
    "exfiltrate_secret",
    "professional_approval_claim",
    "for_construction_claim_without_release",
    "delete_repository",
    "silent_policy_override",
    "unregistered_engine",
    "gateway_bypass",
    "permit_reuse",
    "permit_expired",
    "permit_binding_mismatch",
    "protected_repository_path",
    "symlink_or_junction_escape",
    "non_fast_forward_promotion"
  ],
  "low_risk_mutation_roots": [
    "docs/automation/autonomous_generated/",
    "outputs/runtime/autonomy/"
  ],
  "protected_roots": [
    ".git/",
    "phoenix/",
    "runners/",
    "configs/",
    "tests/",
    ".github/",
    "bib/"
  ],
  "known_bib_governance_side_effect_paths": [
    "bib/PHOENIX_AUTO_SYNC/BIB_BASELINE.md",
    "bib/PHOENIX_AUTO_SYNC/BIB_CURRENT_STATE.json",
    "bib/PHOENIX_AUTO_SYNC/BIB_DISCOVERED_KNOWLEDGE_ROOTS.json",
    "bib/PHOENIX_AUTO_SYNC/BIB_GIT_HISTORY.jsonl",
    "bib/PHOENIX_AUTO_SYNC/BIB_KNOWLEDGE_FALLBACK.jsonl",
    "bib/PHOENIX_AUTO_SYNC/BIB_MANIFEST.json",
    "bib/PHOENIX_AUTO_SYNC/BIB_SYNC_EVIDENCE.txt",
    "bib/PHOENIX_AUTO_SYNC/README.md"
  ],
  "rules": [
    {
      "id": "P2-DENY-POLICY-BYPASS",
      "priority": 1000,
      "effect": "DENY",
      "match": {
        "actions": [
          "policy.bypass",
          "audit.disable",
          "evidence.fabricate",
          "git.force_push",
          "git.history_rewrite",
          "security.exfiltrate_secret",
          "repository.delete"
        ]
      },
      "reason": "North Star invariant: governance, evidence, history and secrets may not be bypassed or falsified."
    },
    {
      "id": "P2-DENY-PROFESSIONAL-IMPERSONATION",
      "priority": 990,
      "effect": "DENY",
      "match": {
        "actions": [
          "professional.sign",
          "professional.approve",
          "release.for_construction.unapproved",
          "release.production.unapproved"
        ]
      },
      "reason": "Phoenix may not impersonate professional approval or issue an unapproved construction/production release."
    },
    {
      "id": "P2-DENY-CRITICAL",
      "priority": 980,
      "effect": "DENY",
      "match": {
        "risks": [
          "CRITICAL"
        ]
      },
      "reason": "CRITICAL autonomous execution is blocked."
    },
    {
      "id": "P2-DENY-HIGH",
      "priority": 970,
      "effect": "DENY",
      "match": {
        "risks": [
          "HIGH"
        ]
      },
      "reason": "HIGH autonomous execution is blocked in Phase 1."
    },
    {
      "id": "P2-ESCALATE-POLICY-CHANGE",
      "priority": 950,
      "effect": "ESCALATE",
      "match": {
        "actions": [
          "policy.modify",
          "north_star.modify",
          "governance.modify"
        ]
      },
      "reason": "Policy and North Star changes are strategic authority decisions."
    },
    {
      "id": "P2-ESCALATE-SOURCE-CODE",
      "priority": 940,
      "effect": "ESCALATE",
      "match": {
        "actions": [
          "source.modify",
          "source.create",
          "source.delete",
          "dependency.install",
          "dependency.upgrade"
        ]
      },
      "reason": "Phoenix source/runtime changes require explicit strategic approval in Phase 1."
    },
    {
      "id": "P2-ESCALATE-EXTERNAL-COMMITMENT",
      "priority": 930,
      "effect": "ESCALATE",
      "match": {
        "actions": [
          "permit.submit",
          "email.send",
          "message.send",
          "contract.sign",
          "purchase.commit",
          "payment.commit",
          "public.publish",
          "production.deploy",
          "cloud.publish"
        ]
      },
      "reason": "External, public, financial or irreversible actions require explicit human approval."
    },
    {
      "id": "P2-ESCALATE-MEDIUM",
      "priority": 900,
      "effect": "ESCALATE",
      "match": {
        "risks": [
          "MEDIUM"
        ]
      },
      "reason": "MEDIUM autonomous execution is not enabled in Phase 1."
    },
    {
      "id": "P2-ALLOW-READ-ONLY-LOW",
      "priority": 800,
      "effect": "ALLOW",
      "match": {
        "risks": [
          "LOW"
        ],
        "mutating": false,
        "external_effect": false
      },
      "reason": "LOW-risk read-only analysis, research and planning may execute autonomously."
    },
    {
      "id": "P2-ALLOW-BACKUP",
      "priority": 790,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "backup.create",
          "backup.verify"
        ],
        "risks": [
          "LOW"
        ]
      },
      "required_gates": [
        "backup_target_outside_repo",
        "baseline_identified"
      ],
      "reason": "Backup operations are autonomous only when they target an external backup root and bind to a known baseline."
    },
    {
      "id": "P2-ALLOW-LOW-RISK-EVIDENCE",
      "priority": 780,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "autonomy.self_improvement.low_risk_evidence",
          "evidence.generate",
          "documentation.update"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "docs/automation/autonomous_generated/",
          "outputs/runtime/autonomy/"
        ]
      },
      "required_gates": [
        "clean_synced",
        "verified_backup",
        "open_source_review",
        "risk_low",
        "allowlisted_path",
        "audit_log"
      ],
      "reason": "LOW-risk documentation/evidence mutation is permitted only inside the existing allowlist with full pre-mutation gates."
    },
    {
      "id": "P2-ALLOW-FF-PROMOTION",
      "priority": 770,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "git.fast_forward_promotion"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true
      },
      "required_gates": [
        "verified_backup",
        "candidate_validated",
        "tests_pass",
        "evidence_pass",
        "ff_only",
        "normal_non_force_push",
        "remote_race_guard",
        "audit_log"
      ],
      "reason": "LOW-risk mainline promotion is permitted only through verified backup-gated fast-forward promotion."
    },
    {
      "id": "P2-ALLOW-BIB-AUTOSYNC",
      "priority": 760,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "bib.auto_sync"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_exact_allowlist": "known_bib_governance_side_effect_paths"
      },
      "required_gates": [
        "provenance",
        "exact_allowlist",
        "no_secret",
        "audit_log"
      ],
      "reason": "BIB auto-sync is allowed only for the exact governance side-effect allowlist."
    },
    {
      "id": "P2-ESCALATE-ENGINE-REGISTRATION",
      "priority": 955,
      "effect": "ESCALATE",
      "match": {
        "actions": [
          "engine.register",
          "engine.registry.modify",
          "gateway.policy.modify"
        ]
      },
      "reason": "Adding or changing mutation-capable engines changes the universal authority boundary."
    },
    {
      "id": "P4-ALLOW-ORCHESTRATION-CHECKPOINT",
      "priority": 775,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "orchestration.checkpoint.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://orchestration/"
        ]
      },
      "required_gates": [
        "audit_log",
        "checkpoint_integrity"
      ],
      "reason": "Durable orchestration state requires gateway authorization and checkpoint integrity."
    },
    {
      "id": "P4-ALLOW-APPROVAL-REQUEST",
      "priority": 774,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "approval.request.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://approvals/"
        ]
      },
      "required_gates": [
        "audit_log",
        "approval_integrity"
      ],
      "reason": "Approval requests require integrity-bound gateway authorization."
    },
    {
      "id": "P4-ALLOW-APPROVAL-RECEIPT",
      "priority": 773,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "approval.receipt.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://approvals/"
        ]
      },
      "required_gates": [
        "audit_log",
        "approval_integrity"
      ],
      "reason": "Approval receipts require integrity-bound gateway authorization."
    },
    {
      "id": "P6-ALLOW-ENGINE-DISCOVERY-SNAPSHOT",
      "priority": 772,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "engine.discovery.snapshot.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://engine_onboarding/"
        ]
      },
      "required_gates": [
        "audit_log",
        "onboarding_integrity"
      ],
      "reason": "Discovery snapshots may be persisted only as integrity-bound runtime artifacts."
    },
    {
      "id": "P6-ALLOW-ENGINE-ONBOARDING-PROPOSAL",
      "priority": 771,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "engine.onboarding.proposal.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://engine_onboarding/"
        ]
      },
      "required_gates": [
        "audit_log",
        "onboarding_integrity"
      ],
      "reason": "Onboarding proposals may be persisted only after bounded admission validation."
    },
    {
      "id": "P6-ALLOW-ADAPTER-SCAFFOLD-STAGING",
      "priority": 770,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "engine.adapter.scaffold.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://engine_onboarding/"
        ]
      },
      "required_gates": [
        "audit_log",
        "onboarding_integrity",
        "admission_tests_pass"
      ],
      "reason": "Generated adapter scaffolds are staging artifacts only and do not activate engines."
    },
    {
      "id": "P7-ALLOW-ACTIVATION-TRANSACTION",
      "priority": 769,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "engine.activation.transaction.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://engine_activation/"
        ]
      },
      "required_gates": [
        "audit_log",
        "activation_integrity"
      ],
      "reason": "Activation transactions are integrity-bound runtime artifacts."
    },
    {
      "id": "P7-ALLOW-ACTIVATION-BUNDLE",
      "priority": 768,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "engine.activation.bundle.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://engine_activation/"
        ]
      },
      "required_gates": [
        "audit_log",
        "activation_integrity",
        "implementation_validation"
      ],
      "reason": "Validated activation bundles may be staged outside the repository."
    },
    {
      "id": "P7-ALLOW-GOVERNED-ACTIVATION-REPO-APPLY",
      "priority": 905,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "engine.activation.repository.apply"
        ],
        "risks": [
          "MEDIUM"
        ],
        "mutating": true
      },
      "required_gates": [
        "human_approval",
        "verified_backup",
        "implementation_validation",
        "exact_scope",
        "policy_bundle_integrity",
        "audit_log"
      ],
      "reason": "A governed engine activation may mutate only its exact generated adapter and registry files after explicit approval and verified backup."
    },
    {
      "id": "P8-ALLOW-ADAPTER-SYNTHESIS-CANDIDATE",
      "priority": 767,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "adapter.synthesis.candidate.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://adapter_synthesis/"
        ]
      },
      "required_gates": [
        "audit_log",
        "synthesis_integrity",
        "static_validation"
      ],
      "reason": "Deterministically synthesized read-only adapters may be staged only as integrity-bound runtime candidates."
    },
    {
      "id": "P8-ALLOW-ADAPTER-VERIFICATION-ATTESTATION",
      "priority": 766,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "adapter.verification.attestation.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://adapter_synthesis/"
        ]
      },
      "required_gates": [
        "audit_log",
        "synthesis_integrity",
        "static_validation",
        "non_executing_verification"
      ],
      "reason": "Static attestations are permitted only when candidate code remains unexecuted."
    },
    {
      "id": "P8-ALLOW-GOVERNED-ADAPTER-HANDOFF",
      "priority": 765,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "adapter.promotion.handoff.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://adapter_synthesis/"
        ]
      },
      "required_gates": [
        "audit_log",
        "synthesis_integrity",
        "explicit_approval",
        "sha_binding",
        "no_repository_write"
      ],
      "reason": "A SHA-bound candidate may be promoted only to Phase-7 review staging, never directly into the repository or activation."
    },
    {
      "id": "P9-ALLOW-LEVEL3-RUNTIME-ATTESTATION",
      "priority": 764,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "autonomy.level3.cycle.attestation.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://level3_cycle/"
        ]
      },
      "required_gates": [
        "audit_log",
        "accepted_security_boundary",
        "static_validation",
        "deterministic_replay",
        "no_repository_write"
      ],
      "reason": "A LOW-risk runtime proof may persist only an integrity-bound attestation after accepted isolation and deterministic replay."
    },
    {
      "id": "P10-ALLOW-ISOLATED-CANDIDATE-WRITE",
      "priority": 763,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "autonomy.repository.candidate.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "worktree://phase10/"
        ]
      },
      "required_gates": [
        "audit_log",
        "clean_synced",
        "verified_backup",
        "impact_lock",
        "protected_path_gate",
        "candidate_worktree_outside_main"
      ],
      "reason": "A LOW-risk candidate may mutate only its isolated Phase-10 worktree after exact impact and protected-path admission."
    },
    {
      "id": "P10-ALLOW-REPOSITORY-CYCLE-ATTESTATION",
      "priority": 762,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "autonomy.repository.cycle.attestation.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://repository_cycle/"
        ]
      },
      "required_gates": [
        "audit_log",
        "accepted_security_boundary",
        "protected_path_gate",
        "deterministic_patch_replay",
        "main_worktree_unchanged"
      ],
      "reason": "A bounded repository cycle may persist only an integrity-bound attestation after isolated verification and deterministic patch replay."
    },
    {
      "id": "P11-ALLOW-MULTI-AGENT-DAG-ATTESTATION",
      "priority": 761,
      "effect": "ALLOW_WITH_GATES",
      "match": {
        "actions": [
          "autonomy.multi_agent.dag.attestation.write"
        ],
        "risks": [
          "LOW"
        ],
        "mutating": true,
        "path_all_under": [
          "runtime://multi_agent_dag/"
        ]
      },
      "required_gates": [
        "audit_log",
        "accepted_security_boundary",
        "dag_cycle_free",
        "deterministic_replay",
        "parallel_bound",
        "read_only_agents"
      ],
      "reason": "A bounded multi-agent DAG may persist only a signed runtime attestation after cycle, determinism, isolation, and parallel-bound gates pass."
    }
  ],
  "domain_authority": {
    "architecture": {
      "analysis": "ALLOW",
      "preliminary_design": "ALLOW_WITH_GATES",
      "issue_for_construction": "DENY"
    },
    "structural": {
      "analysis": "ALLOW",
      "preliminary_calculation": "ALLOW_WITH_GATES",
      "professional_approval": "DENY",
      "for_construction_release": "DENY"
    },
    "permits": {
      "research": "ALLOW",
      "package_preparation": "ALLOW_WITH_GATES",
      "external_submission": "ESCALATE"
    },
    "cost": {
      "analysis": "ALLOW",
      "estimate_preparation": "ALLOW_WITH_GATES",
      "financial_commitment": "ESCALATE"
    },
    "planning": {
      "analysis": "ALLOW",
      "schedule_preparation": "ALLOW_WITH_GATES",
      "external_commitment": "ESCALATE"
    },
    "software": {
      "read_only_analysis": "ALLOW",
      "low_risk_generated_evidence": "ALLOW_WITH_GATES",
      "source_change": "ESCALATE",
      "force_push": "DENY"
    },
    "digital_twin": {
      "read_only_query": "ALLOW",
      "low_risk_metadata_update": "ALLOW_WITH_GATES",
      "destructive_history_rewrite": "DENY"
    },
    "bib": {
      "read_only_query": "ALLOW",
      "exact_auto_sync": "ALLOW_WITH_GATES",
      "unknown_mutation": "DENY"
    }
  },
  "phase": "PHASE_11_BOUNDED_MULTI_AGENT_DAG_ORCHESTRATION",
  "future_engine_contract": {
    "mutation_capable_engine_must_be_registered": true,
    "gateway_required": true,
    "declared_actions_required": true,
    "declared_domains_required": true,
    "declared_path_scope_required_for_file_mutation": true,
    "unregistered_mutation_effect": "DENY"
  },
  "execution_orchestration": {
    "checkpoint_required": true,
    "durable_resume_required": true,
    "approval_receipt_required_for_escalation_resume": true,
    "approval_cannot_override_deny": true,
    "approval_cannot_bypass_gateway": true,
    "mutation_in_progress_replay": "DENY_AUTOMATIC_REPLAY",
    "unknown_executor": "DENY"
  },
  "engine_onboarding": {
    "discovery_is_read_only": true,
    "candidate_manifest_required": true,
    "adapter_generation_is_staging_only": true,
    "activation_requires_governed_repository_change": true,
    "automatic_activation_of_new_mutating_engine": false,
    "unknown_candidate_default": "DENY",
    "static_analysis_before_import": true,
    "arbitrary_plugin_import_during_discovery": false
  },
  "engine_activation": {
    "proposal_must_be_phase6_signed": true,
    "implementation_static_validation_required": true,
    "untrusted_implementation_execution_during_validation": false,
    "governed_install_requires_explicit_human_approval": true,
    "verified_backup_required_before_repository_mutation": true,
    "exact_baseline_required": true,
    "exact_scope_required": true,
    "registry_and_policy_bundle_integrity_required": true,
    "policy_deny_cannot_be_auto_weakened": true,
    "automatic_mutating_engine_activation": false,
    "interrupted_activation_default": "RECOVERY_REQUIRED"
  },
  "adapter_synthesis": {
    "phase6_signed_proposal_required": true,
    "deterministic_read_only_synthesis_only": true,
    "mutation_capable_synthesis": "DENY",
    "candidate_execution_without_security_boundary": "DENY",
    "candidate_code_execution_enabled": false,
    "repository_write_during_synthesis_or_verification": false,
    "signed_attestation_required": true,
    "governed_handoff_requires_explicit_sha_bound_approval": true,
    "handoff_target": "PHASE7_REVIEW_CANDIDATE_ONLY",
    "automatic_engine_activation": false
  },
  "level3_autonomous_cycle": {
    "allowed_risk": "LOW_ONLY",
    "max_tasks_per_invocation": 1,
    "max_repair_attempts": 3,
    "accepted_security_boundary_required": true,
    "provider_install_during_cycle": "DENY",
    "image_pull_during_cycle": "DENY",
    "network_default": "DENY",
    "repository_write_during_runtime_proof": false,
    "deterministic_runtime_replay_required": true,
    "signed_attestation_required": true,
    "automatic_phase7_transaction": false,
    "automatic_engine_activation": false
  },
  "repository_improvement_cycle": {
    "allowed_risk": "LOW_ONLY",
    "max_cycles_per_invocation": 1,
    "max_repair_attempts": 3,
    "candidate_worktree_outside_main_required": true,
